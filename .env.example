# ==========================================
# Anki Vector 2.0 & AI Hybrid Architecture
# Environment Configuration Template
# ==========================================

# --- General System Mode ---
# Donanım simülasyonu: Fiziksel Vector 2.0 veya Insta360 Link 2 olmadan test etmek için True bırakın.
MOCK_ROBOT=True
MOCK_CAMERA=True
LOG_LEVEL=INFO

# --- Arduino UNO Q (Gateway) Settings ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_AUTH_TOKEN=change_this_secret_token_in_production

# --- PC (RTX 5070 + NPU Workstation) Settings ---
PC_HOST=127.0.0.1
PC_PORT=8080
PC_MAC_ADDRESS=AA:BB:CC:DD:EE:FF
PC_WOL_PORT=9
PC_AGENT_TOKEN=change_this_secret_token_in_production

# --- Vector 2.0 Robot (Wire-Pod / gRPC) Settings ---
# Fiziksel robot için Wire-Pod tarafından üretilen sdk_config.ini konfigürasyonu
VECTOR_ROBOT_NAME=Vector-XXXX
VECTOR_ROBOT_IP=192.168.1.150
VECTOR_ROBOT_SERIAL=00000000
VECTOR_CERT_PATH=/opt/vector-gateway/vector.cert

# --- Insta360 Link 2 Camera Settings ---
CAMERA_DEVICE_INDEX=0
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=30

# --- AI & Cloud API Keys ---
# Google AI Studio / Gemini Pro API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash-exp

# --- Local LLM (llama-server on RTX 5070) ---
LOCAL_LLM_URL=http://127.0.0.1:8001/v1
LOCAL_LLM_MODEL=Qwen2.5-14B-Instruct-Q4_K_M

# --- Persistent Memory (sqlite-vec) ---
MEMORY_DB_PATH=vector_memory.db
MEMORY_VECTOR_DIMENSION=768
