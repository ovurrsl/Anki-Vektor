[Unit]
Description=Anki Vector 2.0 Edge Gateway Daemon (Arduino UNO Q)
After=network.target network-online.target arduino-bridge.service
Wants=network-online.target

[Service]
Type=simple
User=antigravity
WorkingDirectory=/opt/vector-gateway
# Wait 25 seconds for Qualcomm BSP, MPU-MCU Bridge, and LED matrix boot logo to complete
ExecStartPre=/bin/sleep 25
ExecStart=/opt/vector-gateway/.venv/bin/python -m gateway.main
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/vector-gateway/.env

# Standard output and error to journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
